<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Tungsten</AssemblyName>
    <RootNamespace>Tungsten</RootNamespace>
    <StartupObject>Tungsten.Program</StartupObject>
    <NoWarn>CS8618;CA1416;WFAC010</NoWarn>
    <ApplicationIcon>Assets\Tungsten.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\*.svg" />
  </ItemGroup>
</Project>
